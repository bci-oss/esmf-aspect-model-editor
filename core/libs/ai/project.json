{
  "name": "ai",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/ai/src",
  "prefix": "ame",
  "targets": {
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": ["{workspaceRoot}/coverage/libs/ai"],
      "options": {
        "tsConfig": "libs/ai/tsconfig.spec.json",
        "watch": false,
        "buildTarget": "ame:build:development"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  },
  "tags": ["scope:features", "layer:features", "type:feature", "access:domain-only"]
}
